{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["src/components/*"],
      "@hooks/*": ["src/hooks/*"],
      "@utils/*": ["src/utils/*"],
      "@types/*": ["src/types/*"],
      "@constants/*": ["src/constants/*"],
      "@assets/*": ["src/assets/*"],
      "@context/*": ["src/context/*"],
      "@config/*": ["src/config/*"],
      "@services/*": ["src/services/*"],
      "@features/*": ["src/features/*"],
      "@layouts/*": ["src/layouts/*"],
      "@lib/*": ["src/lib/*"],
      "@api/*": ["src/api/*"],
      "@store/*": ["src/store/*"],
      "@providers/*": ["src/providers/*"],
      "@styles/*": ["src/styles/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "*.config.ts",
    "*.config.js",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.browser.config.ts",
    "playwright.config.ts",
    "eslint.config.ts",
    "prettier.config.ts",
    "postcss.config.ts",
    "stylelint.config.ts",
    "commitlint.config.ts",
    "lint-staged.config.ts",
    "lighthouserc.js",
    "typedoc.json"
  ],
  "exclude": ["node_modules", "dist", ".next", "coverage", ".cursor"]
}
