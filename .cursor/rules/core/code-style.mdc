## Patterns and Examples
```typescript
// File Organization Pattern
import { type FC } from 'react';
import { useQuery } from '@tanstack/react-query';

import { type User } from '@/types';
import { fetchUser } from '@/api';
import { ErrorBoundary } from '@/components/error';

// Constants
const USER_QUERY_KEY = ['user'] as const;
const RETRY_COUNT = 3;

// Types
interface Props {
  userId: string;
  onError?: (error: Error) => void;
}

// Component
export const UserProfile: FC<Props> = ({ userId, onError }) => {
  const { data: user, error } = useQuery<User>({
    queryKey: USER_QUERY_KEY,
    queryFn: () => fetchUser(userId),
    retry: RETRY_COUNT,
    onError
  });

  if (error) {
    return <ErrorBoundary error={error} />;
  }

  return user ? <UserDetails user={user} /> : null;
};

// Utility Functions Pattern
export function formatCurrency(
  amount: number,
  currency: string = 'USD'
): string {
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency
  }).format(amount);
}

// Error Handling Pattern
export async function safeJsonParse<T>(
  json: string,
  fallback: T
): Promise<T> {
  try {
    return JSON.parse(json) as T;
  } catch {
    return fallback;
  }
}

// Type Definition Pattern
export interface ApiResponse<T> {
  data: T;
  meta: {
    timestamp: string;
    requestId: string;
  };
}

export type ApiError = {
  code: string;
  message: string;
  details?: unknown;
};

// ESM Module Pattern
// file: math.ts
export const add = (a: number, b: number): number => a + b;
export const subtract = (a: number, b: number): number => a - b;

// import in another file
import { add, subtract } from './math.js';
// Note the .js extension - TypeScript compiles to .js and ESM requires extensions

// React Hooks Pattern
import { useState, useEffect, useCallback, useMemo, useRef } from 'react';

// State Hook Pattern
function Counter() {
  // Initialize state with typed value
  const [count, setCount] = useState<number>(0);
  
  // Increment with functional update
  const increment = () => setCount(prevCount => prevCount + 1);
  
  return (
    <button onClick={increment}>
      Count: {count}
    </button>
  );
}

// Effect Hook Pattern
function DataFetcher({ id }: { id: string }) {
  const [data, setData] = useState<Data | null>(null);
  const [error, setError] = useState<Error | null>(null);
  const [loading, setLoading] = useState<boolean>(false);

  useEffect(() => {
    // Effect should have cleanup function
    let isMounted = true;
    
    const fetchData = async () => {
      setLoading(true);
      try {
        const result = await api.getData(id);
        if (isMounted) {
          setData(result);
          setError(null);
        }
      } catch (err) {
        if (isMounted) {
          setError(err instanceof Error ? err : new Error('Unknown error'));
          setData(null);
        }
      } finally {
        if (isMounted) {
          setLoading(false);
        }
      }
    };

    fetchData();
    
    // Cleanup function
    return () => {
      isMounted = false;
    };
  }, [id]); // Explicit dependencies array
  
  if (loading) return <Loading />;
  if (error) return <Error error={error} />;
  return data ? <DataDisplay data={data} /> : null;
}

// Callback Hook Pattern
function SearchComponent({ onSearch }: { onSearch: (term: string) => void }) {
  const [term, setTerm] = useState('');
  
  // Memoize callback to prevent unnecessary re-renders
  const handleSearch = useCallback(() => {
    onSearch(term);
  }, [term, onSearch]);
  
  return (
    <>
      <input 
        value={term} 
        onChange={e => setTerm(e.target.value)} 
      />
      <button onClick={handleSearch}>Search</button>
    </>
  );
}

// Memo Hook Pattern
function ExpensiveCalculation({ data }: { data: number[] }) {
  // Memoize expensive calculations
  const processedData = useMemo(() => {
    return data.filter(n => n > 0).map(n => n * 2).reduce((a, b) => a + b, 0);
  }, [data]);
  
  return <div>Result: {processedData}</div>;
}

// Ref Hook Pattern
function FocusInput() {
  const inputRef = useRef<HTMLInputElement>(null);
  
  const focus = () => {
    inputRef.current?.focus();
  };
  
  return (
    <>
      <input ref={inputRef} />
      <button onClick={focus}>Focus Input</button>
    </>
  );
}

// Modern Browser API Pattern
// Feature detection 
function saveData(data: object) {
  // Check if API is available
  if ('localStorage' in window) {
    try {
      localStorage.setItem('data', JSON.stringify(data));
      return true;
    } catch (e) {
      // Handle quota exceeded or private browsing mode
      console.error('Storage failed:', e);
      return false;
    }
  }
  // Fallback for older browsers
  return false;
}

// Async Browser APIs with error handling
async function getUserLocation(): Promise<GeolocationPosition> {
  // Check if API exists
  if ('geolocation' in navigator) {
    try {
      // Convert callback API to Promise
      return await new Promise((resolve, reject) => {
        navigator.geolocation.getCurrentPosition(resolve, reject, {
          timeout: 5000,
          maximumAge: 60000,
          enableHighAccuracy: true
        });
      });
    } catch (error) {
      // Handle user denied, timeout, etc.
      console.error('Geolocation error:', error);
      throw error;
    }
  }
  
  throw new Error('Geolocation not supported');
}

// Progressive enhancement with modern APIs
function setupNotifications() {
  // Feature detection
  if (!('Notification' in window)) {
    return { supported: false };
  }
  
  // Permission handling
  const requestPermission = async () => {
    if (Notification.permission === 'granted') {
      return true;
    }
    
    if (Notification.permission !== 'denied') {
      const permission = await Notification.requestPermission();
      return permission === 'granted';
    }
    
    return false;
  };
  
  return {
    supported: true,
    requestPermission,
    notify: (title: string, options?: NotificationOptions) => {
      if (Notification.permission === 'granted') {
        return new Notification(title, options);
      }
      return null;
    }
  };
}
```

