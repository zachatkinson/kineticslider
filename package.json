{
  "name": "kineticslider",
  "version": "1.0.0",
  "description": "A high-performance, customizable slider component with kinetic scrolling and advanced effects",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --reporter=verbose && pnpm coverage:enforce",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:desktop": "playwright test --project=chromium --project=firefox --project=webkit --project='Google Chrome'",
    "test:e2e:fast": "playwright test --project=chromium --workers=100%",
    "test:e2e:all": "playwright test --workers=100% --reporter=dot",
    "test:e2e:shard": "playwright test --config=playwright.shard.config.ts",
    "test:e2e:smoke": "playwright test --grep=\"@smoke\" --project=chromium",
    "test:e2e:critical": "playwright test --grep=\"@critical\" --project=chromium --project=firefox",
    "test:e2e:quick": "playwright test --project=chromium --workers=4 --max-failures=5",
    "test:e2e:parallel": "playwright test --workers=80% --reporter=dot",
    "test:e2e:core": "playwright test src/__tests__/e2e/slider-core.e2e.test.ts src/__tests__/e2e/slider-foundation.test.ts --project=chromium --project=firefox",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "tsx scripts/format.ts",
    "format:check": "tsx scripts/format-check.ts",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm validate && pnpm build",
    "docs": "typedoc --out docs src",
    "release": "semantic-release",
    "prepare": "husky",
    "security:audit": "audit-ci --config ./audit-ci.json",
    "bundle:analyze": "size-limit",
    "bundle:check": "size-limit --why",
    "coverage:enforce": "node scripts/enforce-coverage.js",
    "lighthouse:ci": "lhci autorun",
    "setup:https": "bash scripts/setup-https.sh"
  },
  "keywords": [
    "react",
    "slider",
    "kinetic",
    "scroll",
    "effects",
    "filters",
    "performance",
    "typescript"
  ],
  "author": "Zach Atkinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachatkinson/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zachatkinson/kineticslider/issues"
  },
  "homepage": "https://github.com/zachatkinson/kineticslider#readme",
  "peerDependencies": {
    "pixi-filters": "^6.1.2",
    "pixi.js": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.10.2",
    "@eslint/js": "^9.31.0",
    "@lhci/cli": "0.15.0",
    "@playwright/test": "1.51.1",
    "@size-limit/preset-small-lib": "11.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.13.14",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "4.6.0",
    "@vitest/coverage-v8": "3.2.4",
    "audit-ci": "7.1.0",
    "autoprefixer": "10.4.21",
    "cssnano": "7.0.6",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-security": "3.0.1",
    "glob": "11.0.1",
    "globals": "16.0.0",
    "gsap": "3.12.7",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "26.0.0",
    "lint-staged": "15.5.0",
    "lru-cache": "^11.1.0",
    "pixi-filters": "^6.1.3",
    "pixi.js": "^8.11.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "postcss-load-config": "6.0.1",
    "postcss-normalize": "13.0.1",
    "postcss-preset-env": "10.1.5",
    "prettier": "^3.6.2",
    "read-package-up": "^11.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.89.2",
    "semantic-release": "^24.2.7",
    "serve": "14.2.4",
    "size-limit": "11.2.0",
    "tsx": "4.19.3",
    "typedoc": "^0.28.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "8.28.0",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "packageManager": "pnpm@10.7.0",
  "size-limit": [
    {
      "path": "dist/kinetic-slider.es.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "path": "dist/kinetic-slider.umd.js",
      "limit": "100 KB",
      "gzip": true
    }
  ],
  "pnpm": {
    "overrides": {
      "on-headers@<1.1.0": ">=1.1.0",
      "form-data@>=4.0.0 <4.0.4": ">=4.0.4",
      "axios@=1.10.0": ">=1.11.0"
    }
  }
}
