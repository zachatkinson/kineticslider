{
  "name": "kineticslider",
  "version": "1.0.0",
  "description": "A high-performance, customizable slider component with kinetic scrolling and advanced effects",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:check": "vitest run --coverage --reporter=verbose && pnpm coverage:enforce",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:a11y": "axe --dir ./storybook-static --tags wcag2a,wcag2aa,wcag21aa,wcag22aa",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "tsx scripts/format.ts",
    "format:check": "tsx scripts/format-check.ts",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate": "pnpm typecheck && pnpm lint && pnpm test",
    "prepublishOnly": "pnpm validate && pnpm build",
    "docs": "typedoc --out docs src",
    "release": "semantic-release",
    "prepare": "husky",
    "security:audit": "audit-ci --config ./audit-ci.json",
    "bundle:analyze": "size-limit",
    "bundle:check": "size-limit --why",
    "coverage:enforce": "node scripts/enforce-coverage.js",
    "lighthouse:ci": "lhci autorun",
    "setup:https": "bash scripts/setup-https.sh"
  },
  "keywords": [
    "react",
    "slider",
    "kinetic",
    "scroll",
    "effects",
    "filters",
    "performance",
    "typescript"
  ],
  "author": "Zach Atkinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachatkinson/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zachatkinson/kineticslider/issues"
  },
  "homepage": "https://github.com/zachatkinson/kineticslider#readme",
  "peerDependencies": {
    "pixi-filters": "^6.1.2",
    "pixi.js": "^8.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@axe-core/cli": "4.10.2",
    "@eslint/js": "^9.23.0",
    "@lhci/cli": "0.15.0",
    "@playwright/test": "1.51.1",
    "@size-limit/preset-small-lib": "11.2.0",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-docs": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@storybook/test": "^8.6.14",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.1.3",
    "audit-ci": "7.1.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "eslint-plugin-security": "3.0.1",
    "glob": "11.0.1",
    "globals": "16.0.0",
    "gsap": "3.12.7",
    "husky": "9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "26.0.0",
    "lint-staged": "15.5.0",
    "lru-cache": "^11.1.0",
    "pixi-filters": "^6.1.2",
    "pixi.js": "^8.0.0",
    "prettier": "^3.5.3",
    "read-package-up": "^11.0.0",
    "rimraf": "^6.0.1",
    "sass": "^1.86.0",
    "semantic-release": "^24.2.3",
    "size-limit": "11.2.0",
    "storybook": "^8.6.14",
    "tsx": "4.19.3",
    "typedoc": "^0.28.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.28.0",
    "vite": "6.2.3",
    "vitest": "3.1.3"
  },
  "dependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  },
  "size-limit": [
    {
      "path": "dist/kinetic-slider.es.js",
      "limit": "100 KB",
      "gzip": true
    },
    {
      "path": "dist/kinetic-slider.umd.js",
      "limit": "100 KB",
      "gzip": true
    }
  ]
}
