{
  "name": "kineticslider",
  "version": "0.1.0",
  "private": true,
  "description": "KineticSlider - A modern, accessible slider component",
  "author": "Zach",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "pnpm run dev",
    "clean": "rimraf dist coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --reporter=default --reporter=junit",
    "test:e2e": "vitest --config vitest.config.e2e.ts",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx,css,scss}'",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run clean && pnpm run validate && pnpm run build",
    "postpublish": "git push --follow-tags",
    "analyze": "vite build --mode analyze",
    "size": "size-limit",
    "audit": "pnpm audit fix",
    "docs": "typedoc src/index.ts",
    "prepare": "husky install"
  },
  "keywords": ["react", "slider", "typescript", "accessible", "component"],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zach/kineticslider/issues"
  },
  "homepage": "https://github.com/zach/kineticslider#readme",
  "contributing": {
    "type": "individual",
    "url": "https://github.com/zach/kineticslider/blob/main/CONTRIBUTING.md"
  },
  "overrides": {
    "@babel/traverse": "^7.23.2"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/runtime": "^7.27.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "9.23.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.5.1",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/jest-axe": "3.5.9",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.3",
    "@vitest/coverage-v8": "^0.34.0",
    "autoprefixer": "10.4.21",
    "cssnano": "^6.1.2",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^6.0.1",
    "eslint-plugin-vitest": "^0.3.0",
    "globals": "^13.24.0",
    "gsap": "3.12.7",
    "husky": "^8.0.3",
    "jest-axe": "10.0.0",
    "jsdom": "^22.1.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-normalize": "^10.0.1",
    "postcss-preset-env": "^9.6.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "0.6.11",
    "rimraf": "^5.0.5",
    "size-limit": "^11.0.2",
    "stylelint": "16.17.0",
    "stylelint-config-standard": "37.0.0",
    "typescript": "^5.0.2",
    "typescript-eslint": "^7.18.0",
    "vite": "^4.4.5",
    "vitest": "^0.34.0"
  }
}
