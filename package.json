{
  "name": "kineticslider",
  "version": "1.0.0",
  "description": "A high-performance, customizable slider component with kinetic scrolling and advanced effects",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "NODE_NO_WARNINGS=1 jest",
    "test:watch": "NODE_NO_WARNINGS=1 jest --watch",
    "test:coverage": "NODE_NO_WARNINGS=1 jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "prepublishOnly": "npm test && npm run lint && npm run build",
    "docs": "typedoc --out docs src",
    "release": "semantic-release"
  },
  "keywords": [
    "react",
    "slider",
    "kinetic",
    "scroll",
    "effects",
    "filters",
    "performance",
    "typescript"
  ],
  "author": "Zach Atkinson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachatkinson/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zachatkinson/kineticslider/issues"
  },
  "homepage": "https://github.com/zachatkinson/kineticslider#readme",
  "peerDependencies": {
    "pixi-filters": "^6.1.3",
    "pixi.js": "^8.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.30.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.28.0",
    "babel-jest": "^30.0.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gsap": "3.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.0.3",
    "jest-environment-jsdom": "^30.0.2",
    "lru-cache": "^11.1.0",
    "pixi-filters": "^6.1.3",
    "pixi.js": "^8.10.2",
    "prettier": "^3.6.2",
    "read-package-up": "^11.0.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.44.1",
    "rollup-plugin-dts": "^6.2.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "sass": "^1.89.2",
    "semantic-release": "^24.2.6",
    "ts-jest": "^29.4.0",
    "typedoc": "^0.28.6",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
