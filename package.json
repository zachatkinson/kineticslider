{
  "name": "kineticslider",
  "version": "0.1.0",
  "private": true,
  "description": "KineticSlider - A modern, accessible slider component",
  "author": "Zach",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "start": "next start",
    "test": "gtimeout 120s vitest run",
    "test:passing": "vitest run -c vitest.passing.config.js",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "gtimeout 120s vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:types": "tsc -p tsconfig.testing.json --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --config eslint.config.ts --fix .",
    "style": "tsx src/scripts/stylelint-runner.ts",
    "style:fix": "tsx src/scripts/stylelint-runner.ts --fix",
    "format": "tsx src/scripts/format.ts",
    "validate": "pnpm run lint && pnpm run style && pnpm run test",
    "commit": "cz",
    "types:check": "tsc --noEmit",
    "docs:generate": "pnpm run clean:docs && typedoc && jsdoc -c .jsdoc.json",
    "docs:jsdoc": "rimraf docs/jsdoc && jsdoc -c .jsdoc.json",
    "docs:storybook": "storybook dev -p 6006",
    "docs:storybook:build": "storybook build",
    "clean": "rimraf dist .next coverage storybook-static",
    "clean:docs": "rimraf docs/jsdoc docs/api",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=high",
    "precommit": "lint-staged",
    "postinstall": "husky install",
    "release": "changeset publish",
    "version": "changeset version",
    "bundlewatch": "bundlewatch",
    "analyze": "ANALYZE=true next build",
    "lighthouse": "lighthouse-ci",
    "security:scan": "snyk test",
    "lint:jsdoc": "eslint --config eslint.config.ts --ext .ts,.tsx src/ --rule 'jsdoc/require-jsdoc: error'",
    "clean:comments": "tsx src/scripts/cleanComments.ts",
    "type-check": "tsc --noEmit --skipLibCheck",
    "build:worker": "vite build --config vite.worker.config.ts",
    "pretest": "pnpm build:worker",
    "preview": "vite preview",
    "prepare": "husky install",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "keywords": [
    "react",
    "slider",
    "typescript",
    "accessible",
    "component"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zach/kineticslider/issues"
  },
  "homepage": "https://github.com/zach/kineticslider#readme",
  "contributing": {
    "type": "individual",
    "url": "https://github.com/zach/kineticslider/blob/main/CONTRIBUTING.md"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@sentry/browser": "9.10.1",
    "@sentry/react": "^9.10.1",
    "@tanstack/react-query": "^5.71.0",
    "pixi.js": "^8.9.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/runtime": "^7.27.0",
    "@changesets/cli": "^2.28.1",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "^19.8.0",
    "@eslint/js": "^9.23.0",
    "@next/bundle-analyzer": "^15.2.4",
    "@playwright/test": "^1.51.1",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@storybook/addon-a11y": "^8.6.11",
    "@storybook/addon-essentials": "^8.6.11",
    "@storybook/react": "^8.6.11",
    "@storybook/react-vite": "^8.6.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/babel__core": "^7.20.5",
    "@types/eslint-plugin-jsx-a11y": "^6.10.0",
    "@types/glob": "8.1.0",
    "@types/jest-axe": "^3.5.9",
    "@types/js-yaml": "4.0.9",
    "@types/lint-staged": "^13.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "autoprefixer": "^10.4.21",
    "bundlewatch": "^0.4.0",
    "chromatic": "^11.27.0",
    "cssnano": "^7.0.6",
    "eslint": "^9.23.0",
    "eslint-plugin-jsdoc": "50.6.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "glob": "11.0.1",
    "globals": "^16.0.0",
    "globby": "14.1.0",
    "gsap": "^3.12.7",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "js-yaml": "4.1.0",
    "jsdoc": "4.0.4",
    "jsdom": "^26.0.0",
    "lighthouse-ci": "1.13.1",
    "lint-staged": "15.5.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-load-config": "^6.0.1",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^10.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "snyk": "^1.1296.1",
    "stylelint": "^16.17.0",
    "stylelint-config-standard": "^37.0.0",
    "ts-node": "10.9.2",
    "tsx": "4.19.3",
    "typedoc": "0.28.1",
    "typedoc-plugin-markdown": "4.6.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^3.0.9",
    "web-vitals": "4.2.4",
    "zod": "3.24.2"
  },
  "bundlewatch": {
    "files": [
      {
        "path": "dist/*.js",
        "maxSize": "10kB"
      }
    ]
  },
  "lint-staged": {
    "config": "./lint-staged.config.ts"
  }
}
