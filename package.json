{
  "name": "kineticslider",
  "version": "0.1.0",
  "private": true,
  "description": "KineticSlider - A modern, accessible slider component",
  "author": "Zach",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint --config eslint.config.ts .",
    "lint:fix": "eslint --config eslint.config.ts --fix .",
    "style": "stylelint --config stylelint.config.ts \"**/*.{css,scss}\"",
    "style:fix": "stylelint --config stylelint.config.ts --fix \"**/*.{css,scss}\"",
    "format": "prettier --config prettier.config.ts --write .",
    "validate": "pnpm run lint && pnpm run style && pnpm run test",
    "prepare": "husky install",
    "commit": "cz",
    "types:check": "tsc --noEmit",
    "docs:generate": "typedoc",
    "clean": "rimraf dist .next coverage",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --audit-level=high",
    "precommit": "lint-staged",
    "postinstall": "husky install"
  },
  "keywords": [
    "react",
    "slider",
    "typescript",
    "accessible",
    "component"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zach/kineticslider.git"
  },
  "bugs": {
    "url": "https://github.com/zach/kineticslider/issues"
  },
  "homepage": "https://github.com/zach/kineticslider#readme",
  "contributing": {
    "type": "individual",
    "url": "https://github.com/zach/kineticslider/blob/main/CONTRIBUTING.md"
  },
  "overrides": {
    "@babel/traverse": "^7.23.2"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-private-methods": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.27.0",
    "@babel/runtime": "^7.27.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@commitlint/types": "19.8.0",
    "@eslint/js": "9.23.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "5.2.2",
    "@types/babel__core": "7.20.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.0",
    "@types/jest-axe": "3.5.9",
    "@types/lint-staged": "13.3.0",
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.9",
    "autoprefixer": "10.4.21",
    "cssnano": "^7.0.6",
    "eslint": "^9.23.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.1.1",
    "eslint-plugin-vitest": "^0.5.4",
    "globals": "^16.0.0",
    "gsap": "3.12.7",
    "husky": "^9.1.7",
    "jest-axe": "10.0.0",
    "jsdom": "^26.0.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-load-config": "6.0.1",
    "postcss-normalize": "^13.0.1",
    "postcss-preset-env": "^10.1.5",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "0.6.11",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "rimraf": "^6.0.1",
    "size-limit": "^11.2.0",
    "stylelint": "16.17.0",
    "stylelint-config-standard": "37.0.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.28.0",
    "vite": "^6.2.3",
    "vitest": "^3.0.9"
  },
  "lint-staged": {
    "config": "./lint-staged.config.ts"
  }
}
